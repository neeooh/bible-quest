# Copy to .env.local for local development (ignored by git).

# Address of the BibleQuest AI API (the Laravel app in /server), without a trailing slash.
# Leave empty to build without the hosted AI; the app then offers only local Ollama.
VITE_AI_API_URL=http://localhost:8000

# Cloudflare Turnstile site key (public). Leave empty to skip the bot check.
VITE_TURNSTILE_SITE_KEY=
